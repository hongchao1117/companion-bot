# Discord — https://discord.com/developers/applications
DISCORD_TOKEN=

# Owners (at least one). Reviewer username for this assignment:
OWNER_USERNAMES=cm6550

# Optional numeric IDs (comma-separated). Developer Mode → Copy User ID
OWNER_DISCORD_ID=
OWNER_DISCORD_IDS=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Brain files directory
BRAIN_DIR=./data/brain

# Test server: right-click channel → Copy Channel ID (with Developer Mode)
TEST_GUILD_ID=
TEST_CHANNEL_ID=

# OAuth2 invite (fill CLIENT_ID from Developer Portal → General Information):
# https://discord.com/oauth2/authorize?client_id=CLIENT_ID&permissions=84992&scope=bot
